# Kill-view plot window
CS2CD_KILL_WINDOW_BASELINE_TICKS=20
CS2CD_KILL_WINDOW_POST_DEATH_TICKS=20
CS2CD_KILL_WINDOW_SEARCH_BACK_TICKS=256
