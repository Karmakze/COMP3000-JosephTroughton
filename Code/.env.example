# Ingestion threshold (0.0-1.0)
CS2CD_INGEST_THRESHOLD=0.5

# Per-kill cheat-score smoothing window around score tick
CS2CD_KILL_SCORE_WINDOW_TICKS=2

# Engagement break window used for TTD
