# Ingestion threshold (0.0-1.0)
CS2CD_INGEST_THRESHOLD=0.5

# Per-kill cheat-score smoothing window around score tick
CS2CD_KILL_SCORE_WINDOW_TICKS=2

# Engagement break window used for TTD
CS2CD_FORGET_WINDOW_SECONDS=4

# Kill-view plot window
CS2CD_KILL_WINDOW_BASELINE_TICKS=20
CS2CD_KILL_WINDOW_POST_DEATH_TICKS=20
CS2CD_KILL_WINDOW_SEARCH_BACK_TICKS=256

# Default directory for File -> Open Demo / Open Folder dialogs
# Example: /home/youruser/Git/Single Demos
CS2CD_DEFAULT_DEMO_DIR= "/home/karmakaze/Git/Single Demos/"
